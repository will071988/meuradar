# Supabase (Sprint 2 — Auth + perfil)
# Sem essas vars o app roda em modo demo local (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# APIs (Sprint 3)
# Clima: Open-Meteo (grátis, sem chave) — geocoding + forecast
# Mercado: AwesomeAPI (grátis, sem chave) — USD/EUR/BTC-BRL
# Notícias: NewsAPI (opcional, precisa de chave). Sem chave, usa demo.
# Obtenha em https://newsapi.org e preencha abaixo.
NEWS_API_KEY=

# Reservado (futuro)
WEATHER_API_KEY=
MARKET_API_KEY=
