# Supabase (Sprint 2 — Auth + perfil)
# Sem essas vars o app roda em modo demo local (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# APIs (Sprint 3)
# Clima: Open-Meteo (grátis, sem chave) — geocoding + forecast
# Mercado: AwesomeAPI (grátis, sem chave) — USD/EUR/BTC-BRL
# Notícias: feeds RSS públicos do G1 e ge.globo — não exigem chave.

# Vagas BR (opcional — agrega InfoJobs/Indeed no Brasil).
# Sem chaves, usa vagas remotas globais ao vivo (Arbeitnow + Remotive).
# Cadastro gratuito em https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reservado (futuro)
WEATHER_API_KEY=
MARKET_API_KEY=
